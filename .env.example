# Local development only. Never commit the real .env file.
API_PORT=3000
DEVICE_ID=weather-station-001
# Replace with a long, random value before using the API.
DEVICE_SECRET=replace-this-with-a-long-random-secret

# Supabase server-side connection. Never expose the secret key in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key

# Fixed physical location used by the manual Serial Monitor demo.
DEMO_LOCATION_NAME=Capstone demonstration station
DEMO_LATITUDE=40.7128
DEMO_LONGITUDE=-74.0060
DEMO_ENVIRONMENT=indoor
# Nearby official stations to request from the US National Weather Service.
NWS_STATION_LIMIT=5
